NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=alpha
DB_PASSWORD=alpha1234
DB_DATABASE=alpha_mind

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1d

# KIS (한국투자증권) - sandbox: 모의투자, production: 실전투자
KIS_ENV=sandbox
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PROD_CD=01
KIS_HTS_ID=copy3850
# KIS REST 중앙 레이트리밋 — 실무 한도(약 20req/s)보다 보수적으로 운용
KIS_MAX_RPS=8
KIS_RATE_BURST=8
KIS_RATE_MAX_RETRY=5
# KIS WebSocket 접속키/핸드셰이크 timeout — 모의투자 서버 지연을 감안해 REST 기본 10초보다 여유
KIS_WS_APPROVAL_TIMEOUT_MS=15000
KIS_WS_HANDSHAKE_TIMEOUT_MS=15000
# 자동매매 현재가 REST 보강 — WebSocket 우선, stale 종목만 중앙 폴러에서 제한적으로 보강
PRICE_POLL_TICK_MS=1000
PRICE_POLL_MAX_IN_FLIGHT=2
PRICE_POLL_FAILURE_BASE_DELAY_MS=15000
PRICE_POLL_FAILURE_MAX_DELAY_MS=120000
PRICE_POLL_WARN_COOLDOWN_MS=30000
# 일봉 스캔은 후보 선정만 담당하고, scalping 실매수는 완성 1분봉 신호가 확인될 때만 실행
INTRADAY_SCALPING_MIN_CANDLES=5
INTRADAY_SCALPING_MAX_TICK_AGE_MS=90000
INTRADAY_SCALPING_MIN_EXECUTION_STRENGTH=100
INTRADAY_SCALPING_MAX_SPREAD_PCT=0.35
INTRADAY_SCALPING_MIN_VOLUME_RATIO=1.0
SCHEDULED_TRADER_USER_ID=2

# Sprint 2 토글 (기본 OFF, 페이퍼/실거래 검증 시에만 true)
SCALE_OUT_ENABLED=false
R_SIZING_ENABLED=false

# Sprint 3 VI/상하한가 처리 토글 (기본 OFF)
VI_HANDLING_ENABLED=false
VI_CLEAR_TIMEOUT_MS=150000
VI_LIMIT_NEAR_PCT=29.5
VI_STOPLOSS_LIMIT_ORDER=true
VI_REEVAL_DEBOUNCE_MS=1000
NXT_HANDLING_ENABLED=false

# 공격형/보수형 매매 손잡이 (미설정 시 기존 동작 — 인라인 주석 금지)
# 고정 TP/SL 강제(그리드서치·ATR동적 우회). 소액 즉시 익절하려면 true + 아래 낮은 TP
# SCAN_FORCE_FIXED_TP_SL=true
# 익절(TP)은 반드시 양수, 손절(SL)은 반드시 음수여야 함(범위 ±30). 부호가 뒤집히면(또는 0이면)
# 진입 즉시 전량청산되는 사고를 막기 위해 Joi 검증에서 거부되어 backend 부팅이 실패함.
# SCAN_AUTO_TAKE_PROFIT_PCT=1.0
# SCAN_AUTO_STOP_LOSS_PCT=-2.0
# 일봉 매수 신호 최소 강도(0~1, 낮출수록 공격적, 실시간 스켈핑 진입 제외)
# MIN_BUY_SIGNAL_STRENGTH=0.45
# 동시 보유 종목 상한
# MAX_CONCURRENT_HOLDINGS=30
# R기반 사이징 거래당 리스크 %(높일수록 포지션 큼)
# R_RISK_PCT=1.0
